{
  "$schema": "https://schema.tauri.app/config/capability/2",
  "identifier": "shared-chat",
  "description": "Least-privilege scope for the popped-out Shared Agent chat window",
  "windows": ["shared-chat"],
  "permissions": [
    "core:default",
    "allow-shared-agent-request-cmd",
    "allow-shared-agent-stop-cmd",
    "allow-close-shared-chat-window"
  ]
}
