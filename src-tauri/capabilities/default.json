{
  "$schema": "https://schema.tauri.app/config/capability/2",
  "identifier": "default",
  "description": "Least-privilege capability scope for the terminal windows (main and the extra term-N windows)",
  "windows": ["main", "term-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "allow-close-app-window",
    "allow-close-request-ack",
    "allow-set-maximize-button-rect",
    "allow-open-music-pip",
    "allow-close-music-pip",
    "allow-open-shared-chat-window",
    "allow-close-shared-chat-window",
    "allow-music-relay-url",
    "allow-get-available-shells",
    "allow-get-ai-cli-status",
    "allow-get-ai-cli-details",
    "allow-check-ai-cli-path",
    "allow-get-kai-cli-launch-cmd",
    "allow-setup-agent-mcp-cmd",
    "allow-get-agent-setup-snippet-cmd",
    "allow-run-integration-rpc-cmd",
    "allow-cancel-integration-sign-in-cmd",
    "allow-shared-agent-request-cmd",
    "allow-shared-agent-stop-cmd",
    "allow-get-git-info-cmd",
    "allow-run-git-action-cmd",
    "allow-get-git-changes-cmd",
    "allow-get-git-diff-cmd",
    "allow-stage-git-file-cmd",
    "allow-unstage-git-file-cmd",
    "allow-discard-git-file-cmd",
    "allow-open-project-in-editor",
    "allow-detect-installed-editors-cmd",
    "allow-is-call-active-cmd",
    "allow-clipboard-text-begin-cmd",
    "allow-clipboard-text-chunk-cmd",
    "allow-clipboard-text-end-cmd",
    "allow-read-clipboard-attachments-cmd",
    "allow-open-terminal-link-cmd",
    "allow-list-system-fonts-cmd",
    "allow-open-external-url-cmd",
    "allow-search-youtube-video-cmd",
    "allow-search-youtube-videos-cmd",
    "allow-fetch-youtube-playlist-cmd",
    "allow-get-diagnostics",
    "allow-open-terminal-window",
    "allow-take-window-seed",
    "allow-terminal-window-at",
    "allow-send-tab-to-window",
    "allow-take-incoming-tabs",
    "allow-merge-terminal-windows",
    "allow-pty-handoff-begin",
    "allow-pty-handoff-finish",
    "allow-create-pty",
    "allow-write-to-pty",
    "allow-resize-pty",
    "allow-close-pty",
    "allow-get-pty-cwd",
    "allow-pty-busy-sessions",
    "allow-pty-ack",
    "allow-call-watch-set-enabled",
    "allow-get-system-terminal-config",
    "allow-get-app-version",
    "allow-get-autostart-enabled",
    "allow-set-autostart-enabled",
    "allow-get-session-info",
    "allow-list-sessions",
    "allow-get-project-intelligence-cmd",
    "allow-get-active-project-cmd",
    "allow-clear-active-project-cmd",
    "allow-get-kai-cli-status-cmd",
    "allow-ensure-kai-cli-cmd",
    "allow-download-update-asset-cmd",
    "allow-launch-update-installer-cmd",
    "allow-get-update-install-hint-cmd",
    "allow-get-update-arch-cmd"
