{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kai",
  "version": "0.1.3",
  "identifier": "com.kai.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kai Terminal",
        "width": 1000,
        "height": 650,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["../dist/cli/index.js"],
    "publisher": "surajthaqurie",
    "copyright": "Copyright © 2026 surajthaqurie",
    "category": "DeveloperTool",
    "shortDescription": "A modern cross-platform terminal for Windows, Linux, and macOS.",
    "longDescription": "Fast lightweight terminal emulator with optional local AI CLI detection. Works with or without Codex CLI, Claude Code, or Gemini CLI installed. Third-party AI CLI executables are not bundled.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
