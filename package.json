{
  "name": "kai-terminal",
  "private": false,
  "author": "surajthaqurie",
  "license": "MIT",
  "version": "0.1.5",
  "type": "module",
  "bin": {
    "kai": "./bin/kai.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:cli",
    "build:cli": "vite build --config vite.cli.config.ts",
    "build:website": "npm --prefix kai-website run build",
    "build:all": "npm run build && npm run build:website",
    "prepack": "npm run build:cli",
    "setup:cli": "node ./scripts/setup-cli.cjs",
    "doctor": "node ./bin/kai.js --version",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "check": "npm run typecheck && npm run format:check && npm run test",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --no-default-features --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --no-default-features --manifest-path src-tauri/Cargo.toml --lib",
    "prepush": "npm run typecheck && npm run format:check && npm run rust:fmt && npm run rust:clippy && npm run rust:test",
    "bench:perf": "vitest run scripts/bench/step9.perf.test.ts",
    "test:docker": "docker compose -f docker-compose.test.yml run --rm kai-test all",
    "test:docker:frontend": "docker compose -f docker-compose.test.yml run --rm kai-test frontend",
    "test:docker:rust": "docker compose -f docker-compose.test.yml run --rm kai-test rust",
    "test:docker:pty": "docker compose -f docker-compose.test.yml run --rm kai-test pty",
    "test:docker:build": "docker compose -f docker-compose.test.yml build",
    "tauri": "tauri",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:repoint": "bash scripts/repoint-tag.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "~5.6.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
