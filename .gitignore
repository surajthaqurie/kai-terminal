# Dependencies
node_modules/
kai-website/node_modules/

# Build outputs
dist/
dist.old/
kai-website/dist/
kai-website/.next/
kai-website/out/
src-tauri/target/

# Generated website data (rebuilt by predev/prebuild)
kai-website/src/generated/

# IDE / OS files
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local env files
.env
.env.local

# Step 9 benchmark measurements (regenerate with `npm run bench:perf`)
scripts/bench/results/

kai-website/tsconfig.tsbuildinfo

# Snap / Flatpak build inputs and outputs (see packaging/)
packaging/build/
/snap/
*.snap
build-dir/
.flatpak-builder/

# Node.js binary fetched by scripts/fetch-node.mjs for release builds
src-tauri/resources/node/

# Tauri-generated capability schemas (rebuilt on every tauri build/dev)
src-tauri/gen/schemas/
# Permission files tauri-build writes from the app command list in build.rs (APP_COMMANDS)
src-tauri/permissions/autogenerated/
# Vitest JSON report written by `npm run test:ci`
test-results/
